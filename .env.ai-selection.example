# AI selection sidecar and output paths
# Copy required values into the main .env or configure them as GitHub Variables.

# Optional custom installation root. Default: ~/.dsa-ai/upstreams
DSA_AI_UPSTREAM_ROOT=

# Optional explicit Vibe interpreter. Default is derived from DSA_AI_UPSTREAM_ROOT.
VIBE_PYTHON=

# Local/Docker result directory. Default: data/ai_selection
AI_SELECTION_OUTPUT_DIR=data/ai_selection

# GitHub Actions selection parameters
AI_SELECTION_CANDIDATE_LIMIT=12
AI_SELECTION_TOP_N=6

# Start with the existing single-agent analysis path; enable multi-agent after cost/latency validation.
AI_SELECTION_AGENT_MODE=false
AI_SELECTION_AGENT_ARCH=single
AI_SELECTION_ORCHESTRATOR_MODE=standard
